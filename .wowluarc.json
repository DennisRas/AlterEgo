{
  "$schema": "https://raw.githubusercontent.com/TradeSkillMaster/wowlua-ls/main/editors/vscode/wowluarc.schema.json",
  "addonRoot": true,
  "flavors": ["retail"],
  "library": ["Libs/"],
  "inference": {
    "implicitProtectedPrefix": true
  },
  "diagnostics": {
    "enable": [
      "need-check-nil",
      "unknown-param-type",
      "unknown-return-type",
      "unknown-local-type",
      "unknown-field-type"
    ]
  }
}
